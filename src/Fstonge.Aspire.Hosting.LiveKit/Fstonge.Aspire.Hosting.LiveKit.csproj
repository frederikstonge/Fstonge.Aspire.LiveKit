<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Fstonge.Aspire.Hosting.LiveKit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>.NET Aspire hosting integration for LiveKit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
