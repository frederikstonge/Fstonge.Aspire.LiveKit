<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Fstonge.Aspire.Rtc.LiveKit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Configuration and room connection factory for the LiveKit .NET RTC SDK.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Livekit.Rtc.Dotnet" Version="0.1.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
