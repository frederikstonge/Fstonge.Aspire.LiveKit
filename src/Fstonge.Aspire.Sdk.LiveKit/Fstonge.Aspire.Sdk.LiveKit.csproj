<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Fstonge.Aspire.Sdk.LiveKit</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Dependency injection configuration for the LiveKit .NET server SDK.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="Livekit.Server.Sdk.Dotnet" Version="1.2.5" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
